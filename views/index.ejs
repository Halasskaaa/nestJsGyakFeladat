<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Profil szerkesztés
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="container">
        <h1>Profil szerkesztés</h1>
        <form method="post">

            <h3>Termékek:</h3>
            1<input type="radio" name="product" value="Pink" required>
            2<input type="radio" name="product" value="Blue">
            3<input type="radio" name="product" value="Black">

            <label>
                <h3>Név:</h3>
                <input type="text" name="customerName" placeholder="Név">
            </label>

            <label>
                <h3>Számlázási cím:</h3>
                <input type="text" name="billingAddress" placeholder="Számlázási cím">
            </label>

            <label>
                <h3>Szállítási cím:</h3>
                <input type="text" name="shippingAddress" placeholder="Szállítási cím">

            </label>

            <label>
                <h3>Telefonszám:</h3>
                <input type="tel" name="phoneNumber" placeholder="Telefonszám" required>
            </label>

            <label>
                <h3>Kuponkód</h3>
                Kuponkód: <input type="text" name="coupon" placeholder="Kuponkód">
            </label>

            <label>
                <h3>Fizetési eszköz:</h3>
                Bankkártya szám: <input type="text" name="bankcardNumber" placeholder="XXXX-XXXX-XXXX-XXXX"
                    pattern="[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{4}">
                Lejárati dátum: <input type="text" name="expirationDate" placeholder="HH/ÉÉ"
                    pattern="[0-9]{2}/[0-9]{2}">
                Biztonsági kód: <input type="text" name="securityCode" placeholder="***" pattern="[0-9]{3}">
            </label>

            <% if (locals.error) { %>
                <p>
                    <%= locals.error %>
                </p>
                <% } %>
                    <button type="submit">Elküldés</button>
        </form>

        <table>
            <thead>
                <tr>
                    <th>Termék</th>
                    <th>Vásárló neve</th>
                    <th>Számlázási cím</th>
                    <th>Szállítási cím</th>
                </tr>
            </thead>
            
            <tbody>
                <% getProduct.forEach(termek=> { %>
                <tr>
                        <td><%= termek.product %></td>
                        <td><%= termek.customerName %></td>
                        <td><%= termek.billingAddress %></td>
                        <td><%= termek.shippingAddress %></td>
                </tr>
                <%})%>
            </tbody>
        </table>
    </div>

</body>

</html>